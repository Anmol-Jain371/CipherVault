# Personal Encrypted Remote Vault - Server Environment Configuration

# Server host binding (CRITICAL: Bind to 127.0.0.1 behind tunnel for security)
VAULT_HOST=127.0.0.1
VAULT_PORT=8743

# Storage directory (Dedicated folder outside source code)
# Defaults to ~/.personal-vault/data if empty
VAULT_STORAGE_PATH=

# Inactivity and session settings
VAULT_SESSION_IDLE_TIMEOUT_MINUTES=15
VAULT_SESSION_MAX_HOURS=8

# Brute force protection
VAULT_MAX_FAILED_ATTEMPTS=5
VAULT_LOCKOUT_MINUTES=15

# Log level (info, warn, error, debug)
VAULT_LOG_LEVEL=info
